# Turnkey Embedded Wallet demo — environment
#
# This demo is backendless. Authentication methods, OAuth client IDs, session
# length, OTP settings, etc. are all configured on the Turnkey dashboard
# (Embedded Wallets → Configuration) and served to the app via the Auth Proxy.
#
# There are TWO groups below:
#   1. App (frontend)      — public config, safe to ship to the browser.
#   2. Policy-admin CLI     — an OPERATOR SECRET; do NOT put it in the web deploy.

# ─────────────────────────────────────────────────────────────────────────────
# 1. App (frontend) — public config
#    Every value here is a NEXT_PUBLIC_ var: it is bundled into the client and
#    visible to anyone. All are public identifiers/keys — none is a secret.
# ─────────────────────────────────────────────────────────────────────────────

# Required — from the Turnkey dashboard
NEXT_PUBLIC_ORGANIZATION_ID=<your-organization-id>
NEXT_PUBLIC_AUTH_PROXY_ID=<your-auth-proxy-config-id>

# Optional overrides — omit to use Turnkey defaults
# (https://api.turnkey.com and https://authproxy.turnkey.com)
NEXT_PUBLIC_BASE_URL=https://api.turnkey.com
NEXT_PUBLIC_AUTH_PROXY_URL=https://authproxy.turnkey.com

# Optional — Facebook login. Its App ID (public, not a secret) is supplied here;
# Google/Apple are configured on the Turnkey dashboard. Leave unset to hide the
# Facebook button. Facebook reuses the OAuth redirect URL from your
# Auth Proxy dashboard, so that redirect must also be whitelisted in your
# Facebook app (Meta developer console → Facebook Login → Valid OAuth Redirect URIs).
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=<your-facebook-app-id>

# Optional — override the OAuth redirect URL. SINGLE value shared by ALL
# providers (not Facebook-specific). Leave unset to inherit the Auth Proxy
# dashboard's redirect. The value below is a DEV default — unset it (or set your
# production origin) for a real deploy; must be whitelisted in each enabled
# provider's console.
NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3000/

# Optional — the PUBLIC half of the "Policy Manager" P-256 keypair. Only the
# public key belongs in the app (it's safe to expose); it surfaces the 2/2
# co-signing setup actions. The PRIVATE half is the CLI secret below — it must
# NEVER be given a NEXT_PUBLIC_ prefix. Leave unset to hide those actions.
NEXT_PUBLIC_POLICY_MANAGER_PUBLIC_KEY=<your-policy-manager-public-key>

# ─────────────────────────────────────────────────────────────────────────────
# 2. Policy-admin CLI ONLY — operator secret; DO NOT set in the web deployment
#    These are read solely by scripts/policy-admin.ts (run locally by an
#    operator). The deployed frontend never uses them, so do NOT add them to the
#    web host's environment (Vercel, etc.).
# ─────────────────────────────────────────────────────────────────────────────

# The Policy Manager PRIVATE key. This key is a ROOT MEMBER OF EVERY SUB-ORG —
# whoever holds it can co-sign, rewrite policies, change the quorum, or drain any
# wallet, so its compromise is total. Rules:
#   • NEVER prefix it with NEXT_PUBLIC_ (that would ship it to every browser).
#   • Only whoever runs scripts/policy-admin.ts needs it.
#   • Keep it in a secret store (not a plaintext .env in prod), loaded only when
#     the CLI actually signs. Rotate if exposed.
TURNKEY_POLICY_MANAGER_PRIVATE_KEY=<your-policy-manager-private-key>

# The sub-org the CLI operates on (not a secret; just an identifier). Override
# per-run without editing this file via `policy-admin.ts ... --org <subOrgId>`.
TURNKEY_SUBORG_ID=<your-suborg-id>
